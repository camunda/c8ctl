# Normalize all text files to LF line endings in the repository.
# On checkout, Git will use the platform-native line endings only for
# files not explicitly pinned below.
* text=auto

# Always check out with LF regardless of platform
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Compiler inputs and generated workflows must be byte-stable on Windows too.
.github/workflows/** text eol=lf
.github/gh-aw-version text eol=lf
.github/workflows/*.lock.yml linguist-generated=true