{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "semanticCommits": "enabled",
  "rebaseWhen": "behind-base-branch",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "src/templates/**"
  ],
  "automerge": false,
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/gh-aw-version$/"],
      "matchStrings": ["(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s*$"],
      "depNameTemplate": "github/gh-aw",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "AGENTS.md pins the toolchain to Node 22 LTS and treats .nvmrc as authoritative; never bump the Node version.",
      "matchDatasources": ["node-version"],
      "enabled": false
    },
    {
      "description": "Check the compiler daily; GitHub release metadata, not numeric tag shape, decides stability. Toolchain changes require manual review.",
      "matchPackageNames": ["github/gh-aw"],
      "matchDatasources": ["github-releases"],
      "ignoreUnstable": true,
      "schedule": ["before 6am"],
      "automerge": false
    },
    {
      "description": "Compiled agentic workflows are derived files, regenerated only by trusted compiler maintenance.",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/*.lock.yml"],
      "enabled": false
    },
    {
      "description": "assets/c8/8.8, 8.9 and 8.10 pin the camunda/camunda image to a specific test-matrix version (in docker-compose.yml via CAMUNDA_VERSION, and in .env). Renovate has already auto-bumped this pin twice (PR #500, PR #543), breaking the release; do not let it touch these paths again.",
      "matchFileNames": ["assets/c8/8.8/**", "assets/c8/8.9/**", "assets/c8/8.10/**"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": { "enabled": true },
  "osvVulnerabilityAlerts": true
}
